# Supabase — a service role key só é usada no servidor (Server Actions e
# Route Handlers). NUNCA a exponhas com o prefixo NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do site (usada nos links partilhados e no payload do webhook).
# Em produção, ex: https://quiz.famatour.pt
NEXT_PUBLIC_SITE_URL=

# Webhook de automação/CRM. Aponta para o cenário do Make.com (ver
# src/lib/services/automation.ts) — trocar de ferramenta no futuro só
# precisa de mudar este valor, o código não muda.
AUTOMATION_WEBHOOK_URL=

# Analytics — instalados desde o lançamento, mesmo sem campanhas pagas ativas.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# WhatsApp do consultor Famatour, formato internacional sem "+" nem espaços
# (ex: 351912345678). Sem isto o botão "Falar com um consultor" fica inativo.
NEXT_PUBLIC_WHATSAPP_CONSULTOR_NUMERO=
